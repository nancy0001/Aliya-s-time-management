{
  "name": "time-manager-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 4174",
    "dev:web:start": "bash ./scripts/web-daemon.sh start",
    "dev:web:stop": "bash ./scripts/web-daemon.sh stop",
    "dev:web:restart": "bash ./scripts/web-daemon.sh restart",
    "dev:web:status": "bash ./scripts/web-daemon.sh status"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.2.2"
  }
}
